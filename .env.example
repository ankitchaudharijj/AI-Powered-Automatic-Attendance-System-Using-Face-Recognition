# ============================================================
# AI-Powered Automatic Attendance System — Environment Variables
# Copy this file to `.env` and fill in real values before deploying.
# (Uses python-dotenv; app.py loads these automatically if present.)
# ============================================================

# --- Flask ---
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-string
HOST=0.0.0.0
PORT=5000

# --- Database ---
# Default is SQLite. For MySQL use:
# DATABASE_URL=mysql+pymysql://username:password@localhost:3306/attendance_db
DATABASE_URL=sqlite:///database.db

# --- JWT ---
JWT_SECRET_KEY=replace-with-a-different-long-random-string

# --- Default Admin (seeded automatically on first run) ---
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@attendance.local
DEFAULT_ADMIN_PASSWORD=Admin@123

# --- Email Notifications (optional) ---
ENABLE_EMAIL_NOTIFICATIONS=false
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=attendance-system@example.com

# --- CORS (for the REST API) ---
CORS_ORIGINS=*
